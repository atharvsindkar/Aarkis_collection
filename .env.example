# Server Environment
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# Authentication & Cryptographic Keys (Server-side ONLY - Never expose to client)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRE=7d

# Initial Admin Owner Provisioning (Set a strong, unique password before first run)
ADMIN_BOOTSTRAP_EMAIL=admin@your-domain.com
ADMIN_BOOTSTRAP_PASSWORD=your_strong_admin_password_here
ADMIN_BOOTSTRAP_NAME="Aarkis Owner"

# Database Configuration (Optional: set MongoDB URI or leave empty to use local embedded datastore)
MONGO_URI=

# Payment Gateway Credentials (Server-side ONLY)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Transactional Email Verification (Resend API)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM="Aarkis Atelier <concierge@yourdomain.com>"
